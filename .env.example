# SMTP Gmail — use uma App Password (Senha de app) gerada em Conta Google > Segurança
SMTP_USER=seuemail@gmail.com
SMTP_PASS=xxxx-xxxx-xxxx-xxxx

# Destinatário dos formulários de contato
CONTACT_TO=psicologia@mariananora.com.br

# E-mail com permissão de acesso à área administrativa
ADMIN_EMAIL=psicologia@mariananora.com.br

# JSON da service account (firebase-adminsdk) — obrigatório em produção (Vercel).
# Deve ficar em UMA ÚNICA LINHA (JSON minificado) ou em base64; JSON multi-linha quebra.
# No local, alternativamente exporte GOOGLE_APPLICATION_CREDENTIALS com o caminho do arquivo.
FIREBASE_ADMIN_CREDENTIAL=

# Marca o e-mail do admin como verificado (necessário uma única vez após criar o usuário):
# npm run firebase:verify
